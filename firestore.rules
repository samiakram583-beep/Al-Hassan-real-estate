rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'samullah404@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidOptionalUrl(val) {
      return val is string && val.size() <= 600;
    }

    // Entity Validators
    function isValidProperty(data) {
      return data.keys().hasAll([
        'slug', 'title', 'description', 'location', 'address', 'category', 'status',
        'pricePkr', 'bedrooms', 'bathrooms', 'areaValue', 'areaUnit', 'coveredAreaSqFt',
        'plotSizeLabel', 'images', 'features', 'amenities', 'investmentHighlights',
        'lat', 'lng', 'isPublished', 'isFeatured', 'isDemo', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'slug', 'title', 'description', 'location', 'address', 'category', 'status',
        'pricePkr', 'bedrooms', 'bathrooms', 'areaValue', 'areaUnit', 'coveredAreaSqFt',
        'plotSizeLabel', 'images', 'features', 'amenities', 'investmentHighlights',
        'floorPlanUrl', 'virtualTourUrl', 'lat', 'lng', 'isPublished', 'isFeatured',
        'isDemo', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 140 && data.slug.matches('^[a-z0-9\\-]+$')
      && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
      && data.description is string && data.description.size() >= 10 && data.description.size() <= 5000
      && data.location is string && data.location.size() >= 2 && data.location.size() <= 160
      && data.address is string && data.address.size() >= 3 && data.address.size() <= 260
      && data.category in ['Residential', 'Commercial', 'Apartments', 'Houses', 'Plots', 'Investment Properties']
      && data.status in ['For Sale', 'For Rent']
      && data.pricePkr is number && data.pricePkr >= 0 && data.pricePkr <= 100000000000
      && data.bedrooms is number && data.bedrooms >= 0 && data.bedrooms <= 50
      && data.bathrooms is number && data.bathrooms >= 0 && data.bathrooms <= 50
      && data.areaValue is number && data.areaValue > 0 && data.areaValue <= 1000000
      && data.areaUnit in ['Marla', 'Kanal', 'Sq Ft']
      && data.coveredAreaSqFt is number && data.coveredAreaSqFt >= 0 && data.coveredAreaSqFt <= 1000000
      && data.plotSizeLabel is string && data.plotSizeLabel.size() >= 1 && data.plotSizeLabel.size() <= 80
      && data.images is list && data.images.size() <= 20 && (data.images.size() == 0 || (data.images[0] is string && data.images[0].size() <= 600))
      && data.features is list && data.features.size() <= 25 && (data.features.size() == 0 || (data.features[0] is string && data.features[0].size() <= 140))
      && data.amenities is list && data.amenities.size() <= 25 && (data.amenities.size() == 0 || (data.amenities[0] is string && data.amenities[0].size() <= 140))
      && data.investmentHighlights is list && data.investmentHighlights.size() <= 15 && (data.investmentHighlights.size() == 0 || (data.investmentHighlights[0] is string && data.investmentHighlights[0].size() <= 240))
      && (!('floorPlanUrl' in data) || isValidOptionalUrl(data.floorPlanUrl))
      && (!('virtualTourUrl' in data) || isValidOptionalUrl(data.virtualTourUrl))
      && data.lat is number && data.lat >= -90 && data.lat <= 90
      && data.lng is number && data.lng >= -180 && data.lng <= 180
      && data.isPublished is bool
      && data.isFeatured is bool
      && data.isDemo is bool
      && isValidId(data.createdBy)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll([
        'fullName', 'phone', 'email', 'interestedPropertyType',
        'budgetRange', 'message', 'inquiryKind', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'fullName', 'phone', 'email', 'interestedPropertyType',
        'budgetRange', 'message', 'propertyId', 'propertyTitle',
        'inquiryKind', 'status', 'createdAt', 'updatedAt'
      ])
      && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
      && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30
      && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
      && data.interestedPropertyType is string && data.interestedPropertyType.size() >= 2 && data.interestedPropertyType.size() <= 80
      && data.budgetRange is string && data.budgetRange.size() >= 1 && data.budgetRange.size() <= 80
      && data.message is string && data.message.size() >= 2 && data.message.size() <= 2000
      && (!('propertyId' in data) || (data.propertyId is string && data.propertyId.size() <= 128))
      && (!('propertyTitle' in data) || (data.propertyTitle is string && data.propertyTitle.size() <= 160))
      && data.inquiryKind in ['Consultation', 'Property Visit', 'Property Inquiry']
      && data.status in ['new', 'contacted', 'scheduled', 'closed']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
      && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
      && isValidId(data.uid)
      && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
      && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
      && data.role in ['owner', 'admin']
      && data.createdAt is timestamp;
    }

    function isValidBusinessSettings(data) {
      return data.keys().hasAll([
        'businessName', 'phone', 'whatsappNumber', 'officeAddress',
        'plusCode', 'businessHours', 'description', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'businessName', 'phone', 'whatsappNumber', 'officeAddress',
        'plusCode', 'businessHours', 'description', 'googleReviewsUrl',
        'facebookUrl', 'instagramUrl', 'linkedinUrl', 'youtubeUrl', 'updatedAt'
      ])
      && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 120
      && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30
      && data.whatsappNumber is string && data.whatsappNumber.size() >= 7 && data.whatsappNumber.size() <= 25
      && data.officeAddress is string && data.officeAddress.size() >= 5 && data.officeAddress.size() <= 300
      && data.plusCode is string && data.plusCode.size() >= 2 && data.plusCode.size() <= 80
      && data.businessHours is string && data.businessHours.size() >= 2 && data.businessHours.size() <= 160
      && data.description is string && data.description.size() >= 10 && data.description.size() <= 1500
      && (!('googleReviewsUrl' in data) || (data.googleReviewsUrl is string && data.googleReviewsUrl.size() <= 500))
      && (!('facebookUrl' in data) || (data.facebookUrl is string && data.facebookUrl.size() <= 400))
      && (!('instagramUrl' in data) || (data.instagramUrl is string && data.instagramUrl.size() <= 400))
      && (!('linkedinUrl' in data) || (data.linkedinUrl is string && data.linkedinUrl.size() <= 400))
      && (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 400))
      && data.updatedAt is timestamp;
    }

    function isValidPropertyImage(data) {
      return data.keys().hasAll(['title', 'collectionName', 'url', 'isPublic', 'uploadedBy', 'createdAt'])
      && data.keys().hasOnly(['title', 'collectionName', 'url', 'propertyId', 'isPublic', 'uploadedBy', 'createdAt'])
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
      && data.collectionName is string && data.collectionName.size() >= 1 && data.collectionName.size() <= 80
      && data.url is string && data.url.size() >= 5 && data.url.size() <= 600
      && (!('propertyId' in data) || (data.propertyId is string && data.propertyId.size() <= 128))
      && data.isPublic is bool
      && isValidId(data.uploadedBy)
      && data.createdAt is timestamp;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll(['clientName', 'quote', 'rating', 'isPublished', 'createdBy', 'createdAt'])
      && data.keys().hasOnly(['clientName', 'clientRole', 'quote', 'rating', 'isPublished', 'createdBy', 'createdAt'])
      && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100
      && (!('clientRole' in data) || (data.clientRole is string && data.clientRole.size() <= 100))
      && data.quote is string && data.quote.size() >= 10 && data.quote.size() <= 1000
      && data.rating is number && data.rating >= 1 && data.rating <= 5
      && data.isPublished is bool
      && isValidId(data.createdBy)
      && data.createdAt is timestamp;
    }

    // Collections
    match /properties/{propertyId} {
      allow get: if isValidId(propertyId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isAdmin()
        && isValidId(propertyId)
        && isValidProperty(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(propertyId)
        && isValidProperty(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'title', 'description', 'location', 'address', 'category', 'status',
          'pricePkr', 'bedrooms', 'bathrooms', 'areaValue', 'areaUnit', 'coveredAreaSqFt',
          'plotSizeLabel', 'images', 'features', 'amenities', 'investmentHighlights',
          'floorPlanUrl', 'virtualTourUrl', 'lat', 'lng', 'isPublished', 'isFeatured',
          'isDemo', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(propertyId);
    }

    match /inquiries/{inquiryId} {
      allow get: if isAdmin() && isValidId(inquiryId);
      allow list: if isAdmin();
      allow create: if isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(inquiryId);
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (
        (isVerifiedUser() && request.auth.uid == adminUid) || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time;
      allow update: if isBootstrappedAdmin()
        && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role']);
      allow delete: if isBootstrappedAdmin() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    match /business_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(settingId)
        && isValidBusinessSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(settingId)
        && isValidBusinessSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'businessName', 'phone', 'whatsappNumber', 'officeAddress',
          'plusCode', 'businessHours', 'description', 'googleReviewsUrl',
          'facebookUrl', 'instagramUrl', 'linkedinUrl', 'youtubeUrl', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /property_images/{imageId} {
      allow get: if isValidId(imageId) && (existing().isPublic == true || isAdmin());
      allow list: if existing().isPublic == true || isAdmin();
      allow create: if isAdmin()
        && isValidId(imageId)
        && isValidPropertyImage(incoming())
        && incoming().uploadedBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(imageId)
        && isValidPropertyImage(incoming())
        && incoming().uploadedBy == existing().uploadedBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'collectionName', 'propertyId', 'isPublic']);
      allow delete: if isAdmin() && isValidId(imageId);
    }

    match /testimonials/{testimonialId} {
      allow get: if isValidId(testimonialId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isAdmin()
        && isValidId(testimonialId)
        && isValidTestimonial(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(testimonialId)
        && isValidTestimonial(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['clientName', 'clientRole', 'quote', 'rating', 'isPublished']);
      allow delete: if isAdmin() && isValidId(testimonialId);
    }
  }
}
