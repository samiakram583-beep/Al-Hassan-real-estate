{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "Real estate listing managed by Real Estate Investment Consultants.",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 5000
        },
        "location": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 260
        },
        "category": {
          "type": "string",
          "enum": ["Residential", "Commercial", "Apartments", "Houses", "Plots", "Investment Properties"]
        },
        "status": {
          "type": "string",
          "enum": ["For Sale", "For Rent"]
        },
        "pricePkr": {
          "type": "number"
        },
        "bedrooms": {
          "type": "number"
        },
        "bathrooms": {
          "type": "number"
        },
        "areaValue": {
          "type": "number"
        },
        "areaUnit": {
          "type": "string",
          "enum": ["Marla", "Kanal", "Sq Ft"]
        },
        "coveredAreaSqFt": {
          "type": "number"
        },
        "plotSizeLabel": {
          "type": "string",
          "maxLength": 80
        },
        "images": {
          "type": "array"
        },
        "features": {
          "type": "array"
        },
        "amenities": {
          "type": "array"
        },
        "investmentHighlights": {
          "type": "array"
        },
        "floorPlanUrl": {
          "type": "string",
          "maxLength": 600
        },
        "virtualTourUrl": {
          "type": "string",
          "maxLength": 600
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "isPublished": {
          "type": "boolean"
        },
        "isFeatured": {
          "type": "boolean"
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slug",
        "title",
        "description",
        "location",
        "address",
        "category",
        "status",
        "pricePkr",
        "bedrooms",
        "bathrooms",
        "areaValue",
        "areaUnit",
        "coveredAreaSqFt",
        "plotSizeLabel",
        "images",
        "features",
        "amenities",
        "investmentHighlights",
        "lat",
        "lng",
        "isPublished",
        "isFeatured",
        "isDemo",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Client consultation or property visit request.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "interestedPropertyType": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "budgetRange": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2000
        },
        "propertyId": {
          "type": "string",
          "maxLength": 128
        },
        "propertyTitle": {
          "type": "string",
          "maxLength": 160
        },
        "inquiryKind": {
          "type": "string",
          "enum": ["Consultation", "Property Visit", "Property Inquiry"]
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "scheduled", "closed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "fullName",
        "phone",
        "email",
        "interestedPropertyType",
        "budgetRange",
        "message",
        "inquiryKind",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["owner", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Editable consultancy contact and profile settings.",
      "type": "object",
      "properties": {
        "businessName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30
        },
        "whatsappNumber": {
          "type": "string",
          "minLength": 7,
          "maxLength": 25
        },
        "officeAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "plusCode": {
          "type": "string",
          "maxLength": 80
        },
        "businessHours": {
          "type": "string",
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500
        },
        "googleReviewsUrl": {
          "type": "string",
          "maxLength": 500
        },
        "facebookUrl": {
          "type": "string",
          "maxLength": 400
        },
        "instagramUrl": {
          "type": "string",
          "maxLength": 400
        },
        "linkedinUrl": {
          "type": "string",
          "maxLength": 400
        },
        "youtubeUrl": {
          "type": "string",
          "maxLength": 400
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "businessName",
        "phone",
        "whatsappNumber",
        "officeAddress",
        "plusCode",
        "businessHours",
        "description",
        "updatedAt"
      ]
    },
    "PropertyImage": {
      "title": "PropertyImage",
      "description": "Gallery image asset managed by admin.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "collectionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600
        },
        "propertyId": {
          "type": "string",
          "maxLength": 128
        },
        "isPublic": {
          "type": "boolean"
        },
        "uploadedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "collectionName", "url", "isPublic", "uploadedBy", "createdAt"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Owner-supplied verified client testimonial.",
      "type": "object",
      "properties": {
        "clientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "clientRole": {
          "type": "string",
          "maxLength": 100
        },
        "quote": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "rating": {
          "type": "number"
        },
        "isPublished": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["clientName", "quote", "rating", "isPublished", "createdBy", "createdAt"]
    }
  },
  "firestore": {
    "/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/Property" },
      "description": "Curated and demonstration real estate listings."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Client consultation and property visit inquiries (admin-only read)."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized administrator registry."
    },
    "/business_settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Consultancy business profile and contact settings."
    },
    "/property_images/{imageId}": {
      "schema": { "$ref": "#/entities/PropertyImage" },
      "description": "Managed image gallery assets and collections."
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Owner-supplied verified client testimonials."
    }
  }
}
